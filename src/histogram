#include <iostream>
using namespace std;

int main()
{
    int data[8] = {2, 3, 3, 4, 4, 4, 5, 5};
    int frequency[6] = {0};

    for (int i = 0; i < 8; i++)
    {
        frequency[data[i]]++;
    }

    for (int i = 1; i <= 5; i++)
    {
        cout << i << ": ";

        for (int j = 0; j < frequency[i]; j++)
        {
            cout << "*";
        }

        cout << endl;
    }

    return 0;
}